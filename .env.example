# Copy to .env.local for dev. Never commit real values. Missing keys = stub mode.
APP_NAME=postslot
NEXT_PUBLIC_APP_URL=http://localhost:3000
# memory | mongo (defaults to mongo when MONGODB_URI is set)
DB_DRIVER=memory
MONGODB_URI=
MONGODB_DB=postslot
# >= 32 random chars, unique per app: openssl rand -base64 32
BETTER_AUTH_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# console | resend | smtp
MAIL_PROVIDER=console
RESEND_API_KEY=
MAIL_FROM=
CRON_SECRET=
# Svix style signing secret of the mail provider webhook (POST /api/hooks/mail)
MAIL_WEBHOOK_SECRET=
# Own mail server path (docs/OWN_MTA.md). Only used when MAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_BOUNCE_DOMAIN=
SMTP_DAILY_CAP=
SMTP_DKIM_DOMAIN=
SMTP_DKIM_SELECTOR=
SMTP_DKIM_PRIVATE_KEY=
# Shared secret for POST /api/hooks/dsn (bounces from the own mail server)
DSN_WEBHOOK_SECRET=
ALTCHA_HMAC_KEY=
# JSON of remote flags, e.g. {"payments_enabled":"on"}
APP_FLAGS=
# comma separated founder admin emails
ADMIN_EMAILS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
